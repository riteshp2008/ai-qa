# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Browserbase
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# AI
GEMINI_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (join-request and invite notifications). Without a key, emails are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="Sentinel <notifications@your-domain.com>"

# GitHub (optional: raises API rate limits and allows linking private repositories the token can read)
GITHUB_TOKEN=

# Agentic test pipeline
# Sandbox: E2B microVMs with Docker inside. Build the template once: `npm run e2b:template`.
E2B_API_KEY=
E2B_TEMPLATE=sentinel-docker
SANDBOX_PROVIDER=e2b
# Models (Gemini via LangChain). Reasoning model for code-writing agents, fast model for analysis/summaries.
AGENT_MODEL=gemini-2.5-pro
AGENT_FAST_MODEL=gemini-2.5-flash
# GitHub App (recommended): per-repo, least-privilege tokens — read-only for the sandbox, write only for opening PRs.
# Permissions: Contents (read & write), Pull requests (read & write), Metadata (read).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Max pipelines running at once across the deployment (each project is limited to one).
PIPELINE_CONCURRENCY=5
# Set to 1 when using the local Inngest dev server (npx inngest-cli dev).
INNGEST_DEV=
